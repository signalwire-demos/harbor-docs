# Harbor Docs — example env vars
#
# Copy to .env for local development.

# DocsBot agent URL. In local dev this is your ngrok tunnel URL pointing at
# the agent on port 3000. The widget fetches /get_token from here to start
# a call.
#
# Example:
#   PUBLIC_DOCSBOT_AGENT_URL=https://abc123.ngrok-free.app
#
# Leave empty in production if you inject via a runtime config endpoint.
PUBLIC_DOCSBOT_AGENT_URL=
